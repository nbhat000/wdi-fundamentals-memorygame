{
  "name": "espn-fantasy-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for reading and writing ESPN fantasy sports (football, basketball, baseball) using your own session cookies",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "espn-fantasy-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "start:http": "ESPN_MCP_TRANSPORT=http node dist/http.js",
    "agent": "node dist/agent.js",
    "agent:dry": "AUTO_EXECUTE=false node dist/agent.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
