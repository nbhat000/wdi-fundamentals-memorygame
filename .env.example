# Copy to .env and fill in. Never commit the real .env.
#
# How to get ESPN_S2 and ESPN_SWID:
#   1. Log into fantasy.espn.com in any browser with your league account.
#   2. Open DevTools -> Application (Chrome) or Storage (Firefox) -> Cookies -> https://fantasy.espn.com
#   3. Copy the value of `espn_s2` (long string) and `SWID` (looks like {XXXXXXXX-XXXX-...}).
# These expire after roughly a month; when reads start failing with a 401,
# the server will tell you to refresh them here rather than retrying.
ESPN_S2=
ESPN_SWID={PASTE-SWID-WITH-BRACES}

# Defaults used when a tool call omits sport/season/league_id/team_id.
ESPN_SPORT=ffl
ESPN_SEASON=2026
ESPN_LEAGUE_ID=
ESPN_TEAM_ID=

# Set to true only after you've verified dry runs look correct. While false,
# every write tool always behaves as a dry run regardless of the dry_run argument.
WRITES_ENABLED=false

ESPN_MCP_TRANSPORT=http
PORT=3000
MCP_BEARER_TOKEN=replace-with-32-char-random-secret
AUTO_EXECUTE=false
